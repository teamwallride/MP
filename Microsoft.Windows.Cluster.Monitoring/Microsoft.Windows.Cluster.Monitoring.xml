          <Name>Cluster Node State</Name>
        </DisplayString>
        <DisplayString ElementID="TestA.Microsoft.Windows.Cluster.Monitor.NodeState" SubElementID="Healthy">
          <Name>Healthy</Name>
        </DisplayString>
        <DisplayString ElementID="TestA.Microsoft.Windows.Cluster.Monitor.NodeState" SubElementID="Error">
          <Name>Error</Name>
        </DisplayString>
        <DisplayString ElementID="TestA.Microsoft.Windows.Cluster.Monitor.NodeState.AlertMessage">
